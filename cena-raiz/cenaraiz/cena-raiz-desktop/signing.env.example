# Credenciais de assinatura e notarizacao do cena-raiz 
# Copie para "signing.env" (que e ignorado pelo git) e preencha.
# NUNCA commitar o signing.env preenchido; segredos nao entram no repositorio.

# Nome exato da identidade no Keychain, apos instalar o certificado
# Developer ID Application. Descubra com:
#   security find-identity -v -p codesigning

# --- OTA: bucket Cloudflare R2 ---------------------------------------------
# Account ID do Cloudflare (dashboard -> R2 -> canto direito).
CENA_RAIZ_CF_ACCOUNT_ID=""
# API token com permissao "R2 - Edit" (dashboard -> R2 -> Manage API Tokens).
CENA_RAIZ_CF_API_TOKEN=""
# Nome do bucket (ex.: cena-raiz-updates).
CENA_RAIZ_R2_BUCKET=""
# URL publica do bucket (r2.dev habilitado no bucket, ou dominio proprio).
CENA_RAIZ_UPDATE_BASE_URL=""
