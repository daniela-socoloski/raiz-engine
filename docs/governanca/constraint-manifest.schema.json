{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/daniela-socoloski/raiz-engine/docs/governanca/constraint-manifest.schema.json",
  "title": "Constraint Manifest",
  "description": "Contrato de restricoes de um sistema. Fonte unica da estrutura: o validador le os enums e os campos obrigatorios deste arquivo.",
  "type": "object",
  "required": ["manifest_version", "system", "constraints"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "string", "enum": ["1"] },
    "system": {
      "type": "object",
      "required": ["name", "owner", "tier", "updated"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "tier": { "type": "string", "enum": ["minimo", "completo"] },
        "tier_rationale": { "type": "string" },
        "updated": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "statement", "moment", "enforcement", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "class": {
            "type": "string",
            "enum": [
              "non_negotiable",
              "forbidden_outcome",
              "forbidden_method",
              "evidence_requirement",
              "approval_boundary",
              "stop_condition",
              "escalation_condition",
              "optimization_exclusion",
              "data_boundary",
              "budget_boundary",
              "reversibility_requirement",
              "commit_policy"
            ]
          },
          "statement": { "type": "string" },
          "authority": {
            "type": "string",
            "enum": ["AUTO", "SESSION", "APPROVAL", "EVIDENCE", "ESCALATE", "FORBIDDEN"]
          },
          "moment": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["design", "build", "runtime", "post"] }
          },
          "enforcement": {
            "type": "object",
            "required": ["mechanism"],
            "additionalProperties": false,
            "properties": {
              "mechanism": {
                "type": "string",
                "enum": ["type", "schema", "test", "permission", "policy", "monitor", "review", "manual"]
              },
              "reference": { "type": "string" },
              "responsible": { "type": "string" }
            }
          },
          "status": { "type": "string", "enum": ["ACCEPTED", "PROPOSAL", "DEFERRED"] },
          "source": { "type": "string" },
          "removal_condition": { "type": "string" }
        }
      }
    }
  }
}
