{
  "name": "@cena-raiz/desktop",
  "productName": "cena-raiz",
  "version": "0.13.8",
  "description": "Aplicativo desktop do editor de video por conversa cena-raiz",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:ffmpeg": "node scripts/build-ffmpeg.mjs",
    "build:ffmpeg:torchcodec": "node scripts/fetch-ffmpeg-source.mjs 7.1.5 ffmpeg-torchcodec && node scripts/build-ffmpeg-torchcodec.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg-source.mjs",
    "stage:node": "node scripts/stage-node.mjs",
    "stage:uv": "node scripts/stage-uv.mjs",
    "stage:yt-dlp": "node scripts/stage-yt-dlp.mjs",
    "stage:codex": "node scripts/stage-codex-app-server.mjs",
    "test:codex-protocol": "node scripts/smoke-codex-app-server.mjs",
    "test:timeline": "node scripts/test-timeline-model.mjs",
    "test:media": "node scripts/test-media-selection.mjs",
    "test:helpers": "node scripts/test-helpers.mjs",
    "test:jcut": "node scripts/test-jcut.mjs",
    "test:direction-plan": "node scripts/test-direction-plan.mjs",
    "test:motion-registry": "node scripts/test-motion-registry.mjs",
    "test:member-auth-storage": "node scripts/test-member-auth-storage.mjs",
    "test:signing-env": "node scripts/test-signing-env.mjs",
    "test:gpg-host": "node scripts/test-gpg-host.mjs",
    "test:runtime-resolution": "node scripts/test-runtime-resolution.mjs",
    "smoke:creator": "node scripts/smoke-creator-build.mjs",
    "motion:fingerprints": "node scripts/refresh-motion-fingerprints.mjs",
    "test": "npm run test:timeline && npm run test:media && npm run test:helpers && npm run test:jcut && npm run test:direction-plan && npm run test:motion-registry && npm run test:member-auth-storage && npm run test:signing-env && npm run test:gpg-host && npm run test:runtime-resolution",
    "stage:python-whisperx": "node scripts/stage-python-whisperx.mjs",
    "prepare:forge-makers": "node scripts/prepare-forge-makers.mjs",
    "typecheck": "tsc --noEmit",
    "make:prepared": "npm run prepare:forge-makers && npx --yes --package=node@22.23.2 -c \"electron-forge make\"",
    "package": "npm run stage:node && npm run stage:uv && npm run stage:yt-dlp && npm run stage:codex && npm run build:ffmpeg && npm run build:ffmpeg:torchcodec && npm run stage:python-whisperx && npx --yes --package=node@22.23.2 -c \"electron-forge package\"",
    "make": "npm run stage:node && npm run stage:uv && npm run stage:yt-dlp && npm run stage:codex && npm run build:ffmpeg && npm run build:ffmpeg:torchcodec && npm run stage:python-whisperx && npm run prepare:forge-makers && npx --yes --package=node@22.23.2 -c \"electron-forge make\"",
    "make:creator": "node scripts/make-creator.mjs",
    "make:creator:prepared": "node scripts/make-creator.mjs --prepared",
    "verify:creator": "node scripts/verify-creator-build.mjs",
    "make:signed": "node scripts/with-signing-env.mjs npm run make",
    "publish:update": "node scripts/with-signing-env.mjs node scripts/publish-update.mjs",
    "pack:runtimes": "node scripts/pack-runtimes.mjs",
    "publish:runtimes": "node scripts/with-signing-env.mjs node scripts/publish-runtimes.mjs"
  },
  "author": "Raiz Engine",
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/lib-storage": "^3.1112.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "43.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "esbuild@0.21.5": true
  }
}
